# ========================================================
# PeoplePolicy AI - إعدادات البيئة
# ========================================================

# مفتاح Google Gemini API (اختياري)
# اتركه فارغاً لتشغيل التطبيق في "الوضع المحلي الحتمي" بدون الحاجة لمفتاح
GEMINI_API_KEY=

# اسم نموذج Gemini المستخدم عند تفعيل المفتاح
GEMINI_MODEL=gemini-2.5-flash

# عتبة درجة التشابه لمحرك RAG المحلي (Cosine Similarity Threshold)
RAG_SIMILARITY_THRESHOLD=0.12

# الحد الأقصى لعدد استدعاءات الأدوات في الطلب الواحد
MAX_TOOL_CALLS=3
